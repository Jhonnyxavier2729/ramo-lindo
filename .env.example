# Copia este archivo como .env.local y pega tus claves de Supabase
# (Supabase → Project Settings → API). Sin ellas la app funciona en "modo demo".
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo en Vercel: protege el cron que mantiene Supabase despierto.
CRON_SECRET=una-cadena-larga-y-aleatoria
